
<footer class="site"><a class="brand" href="/">Wasi Café<small>La Casa del Café</small></a><div class="fr"></div><p>Un café, una oportunidad · San Isidro, Lima</p><p style="margin-top:.4rem"><a href="https://wa.me/51908724496?text=Hola!%20Quiero%20info%20de%20Wasi%20Caf%C3%A9%20%E2%98%95" target="_blank" rel="noopener">+51 908 724 496</a></p></footer>
<script>(function(){var SUN='<svg id=\'themeIcon\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'1.4\' stroke-linecap=\'round\'><circle cx=\'12\' cy=\'12\' r=\'4.5\'/><path d=\'M12 2v2M12 20v2M4 12H2M22 12h-2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19\'/></svg>';var MOON='<svg id=\'themeIcon\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'1.4\' stroke-linecap=\'round\'><path d=\'M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z\'/></svg>';function sync(){var d=document.documentElement.getAttribute('data-theme')==='dark';var i=document.getElementById('themeIcon');if(i)i.outerHTML=d?SUN:MOON;var m=document.querySelector('meta[name=theme-color]');if(m)m.setAttribute('content',d?'#15100C':'#F7F1E8');}sync();document.getElementById('themeBtn').addEventListener('click',function(){var d=document.documentElement.getAttribute('data-theme')!=='dark';document.documentElement.setAttribute('data-theme',d?'dark':'light');try{localStorage.setItem('wasi-theme',d?'dark':'light');}catch(e){}sync();});var h=document.querySelector('header');addEventListener('scroll',function(){h.classList.toggle('scrolled',scrollY>24);},{passive:true});})();</script>
</body>
