<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
<script>(function(){document.documentElement.classList.add("js");try{var p=localStorage.getItem("wasi-theme");if(p)document.documentElement.setAttribute("data-theme",p);}catch(e){}})();</script>
<style>
:root{--bg:#F7F1E8;--bg-alt:#FFFFFF;--bg-deep:#1E1611;--ink:#261C15;--ink-soft:#7B6B5C;
--gold:#A87C3D;--gold-soft:rgba(168,124,61,.30);--line:rgba(38,28,21,.12);--paper:#FBF7F0;
--display:'Cormorant Garamond',Georgia,serif;--body:'Outfit',system-ui,sans-serif;
--safe-b:env(safe-area-inset-bottom,0px);--safe-t:env(safe-area-inset-top,0px);}
[data-theme="dark"]{--bg:#15100C;--bg-alt:#1B1510;--bg-deep:#100B08;--ink:#EFE6D8;--ink-soft:#A2917F;
--gold:#CFA45B;--gold-soft:rgba(207,164,91,.32);--line:rgba(239,230,216,.14);--paper:#1B1510;}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-weight:300;line-height:1.75;-webkit-font-smoothing:antialiased;overflow-x:hidden}
.wrap{max-width:1120px;margin:0 auto;padding:0 1.6rem}
.read{max-width:720px;margin:0 auto;padding:0 1.6rem}
a{color:inherit}
header{position:sticky;top:0;z-index:60;display:flex;align-items:center;gap:1rem;padding:calc(1rem + var(--safe-t)) 1.6rem 1rem;
background:color-mix(in srgb,var(--bg) 82%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid transparent;transition:.4s}
header.scrolled{padding-top:.65rem;padding-bottom:.65rem;border-bottom-color:var(--line)}
.brand{font-family:var(--display);font-size:1.4rem;font-weight:500;color:var(--ink);text-decoration:none;line-height:1}
.brand small{display:block;font-family:var(--body);font-size:.52rem;font-weight:500;letter-spacing:.32em;text-transform:uppercase;color:var(--gold);margin-top:4px}
nav{margin-left:auto;display:flex;align-items:center;gap:1.8rem}
nav a.lnk{color:var(--ink-soft);font-size:.74rem;font-weight:400;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;transition:.25s}
nav a.lnk:hover{color:var(--gold)}
@media(max-width:820px){nav a.lnk{display:none}}
.ibtn{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:transparent;border:1px solid var(--line);color:var(--ink);cursor:pointer;transition:.25s}
.ibtn:hover{border-color:var(--gold);color:var(--gold)}.ibtn svg{width:17px;height:17px}
.eyebrow{font-size:.66rem;font-weight:500;letter-spacing:.34em;text-transform:uppercase;color:var(--gold)}
.rule{width:46px;height:1px;background:var(--gold);opacity:.7;margin:1.4rem auto}
.crumbs{font-size:.72rem;letter-spacing:.04em;color:var(--ink-soft);padding:1.6rem 0 0}
.crumbs a{color:var(--gold);text-decoration:none}.crumbs span{opacity:.5;margin:0 .4rem}
/* Hero artículo */
.ahero{text-align:center;padding:3rem 0 2.4rem}
.ahero h1{font-family:var(--display);font-weight:400;font-size:clamp(2.1rem,5.2vw,3.4rem);line-height:1.1;color:var(--ink);margin-top:1rem}
.ameta{font-size:.74rem;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);margin-top:1.2rem}
/* Prosa */
.prose{padding:1rem 0 2rem;font-size:1.06rem;color:var(--ink)}
.prose p{margin:0 0 1.3rem}
.prose h2{font-family:var(--display);font-weight:500;font-size:clamp(1.6rem,3.4vw,2.1rem);color:var(--ink);margin:2.6rem 0 1rem;line-height:1.15}
.prose h3{font-family:var(--display);font-weight:500;font-size:1.4rem;color:var(--ink);margin:1.8rem 0 .7rem}
.prose strong{font-weight:600;color:var(--ink)}
.prose em{font-style:italic}
.prose a{color:var(--gold);text-decoration:none;border-bottom:1px solid var(--gold-soft);transition:.2s}
.prose a:hover{border-bottom-color:var(--gold)}
.prose ul,.prose ol{margin:0 0 1.4rem 1.2rem;padding-left:.8rem}
.prose li{margin:0 0 .6rem}
.prose blockquote{border-left:2px solid var(--gold);padding-left:1.2rem;margin:1.6rem 0;font-family:var(--display);font-style:italic;font-size:1.3rem;color:var(--ink-soft)}
/* FAQ */
.faq{border-top:1px solid var(--line);margin-top:2.5rem;padding-top:1rem}
.faq h2{font-family:var(--display);font-weight:500;font-size:1.7rem;color:var(--ink);margin-bottom:.6rem}
.faq details{border-top:1px solid var(--line)}
.faq details:last-child{border-bottom:1px solid var(--line)}
.faq summary{list-style:none;cursor:pointer;padding:1.1rem 0;font-family:var(--display);font-size:1.25rem;font-weight:500;color:var(--ink);display:flex;justify-content:space-between;align-items:center;gap:1rem}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"";width:10px;height:10px;border-right:1px solid var(--gold);border-bottom:1px solid var(--gold);transform:rotate(45deg);transition:.3s;flex-shrink:0}
.faq details[open] summary::after{transform:rotate(-135deg)}
.faq details p{padding:0 0 1.1rem;color:var(--ink-soft);font-size:.95rem;font-weight:300}
/* CTA */
.cta{background:var(--paper);border:1px solid var(--gold-soft);border-radius:4px;padding:2.2rem 1.6rem;text-align:center;margin:3rem 0}
.cta h3{font-family:var(--display);font-weight:500;font-size:1.7rem;color:var(--ink)}
.cta p{color:var(--ink-soft);max-width:32rem;margin:.5rem auto 1.3rem;font-weight:300}
.btn{display:inline-flex;align-items:center;gap:.5rem;font-weight:400;font-size:.8rem;letter-spacing:.06em;text-transform:uppercase;padding:.9rem 1.6rem;border-radius:2px;text-decoration:none;border:1px solid var(--ink);background:var(--ink);color:var(--bg);transition:.3s}
.btn:hover{background:var(--gold);border-color:var(--gold);color:#fff}
.back{display:inline-block;margin:1rem 0 0;color:var(--gold);text-decoration:none;font-size:.85rem;letter-spacing:.04em}
/* Index */
.bhero{text-align:center;padding:5rem 0 1rem}
.bhero h1{font-family:var(--display);font-weight:300;font-size:clamp(2.6rem,7vw,4.4rem);color:var(--ink);line-height:1;margin-top:1.2rem}
.bhero h1 em{font-style:italic;color:var(--gold)}
.bhero .lead{color:var(--ink-soft);max-width:34rem;margin:1.2rem auto 0;font-weight:300}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:1.4rem;padding:3rem 0 1rem}
@media(max-width:720px){.grid{grid-template-columns:1fr}}
.post{display:block;text-decoration:none;border:1px solid var(--line);border-radius:4px;padding:2rem 1.8rem;background:var(--bg-alt);transition:.3s}
.post:hover{border-color:var(--gold-soft);transform:translateY(-3px)}
.post .k{font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)}
.post h2{font-family:var(--display);font-weight:500;font-size:1.7rem;color:var(--ink);margin:.6rem 0 .5rem;line-height:1.2}
.post p{color:var(--ink-soft);font-size:.92rem;font-weight:300}
.post .more{display:inline-block;margin-top:1rem;color:var(--gold);font-size:.8rem;letter-spacing:.06em;text-transform:uppercase}
footer.site{background:var(--bg-deep);color:#EFE6D8;text-align:center;padding:3.2rem 1.6rem calc(2.2rem + var(--safe-b));border-top:1px solid var(--line);margin-top:3rem}
footer.site .brand{color:#fff}
footer.site .fr{width:46px;height:1px;background:var(--gold);opacity:.6;margin:1.3rem auto}
footer.site p{color:rgba(239,230,216,.5);font-size:.78rem;font-weight:300}
footer.site a{color:var(--gold);text-decoration:none}
@media (prefers-reduced-motion: reduce){*{transition:none!important}}
</style>
